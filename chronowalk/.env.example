# Required — Mapbox public token (also set in Netlify Environment variables)
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# v2 media CDN (Cloudflare R2 custom domain)
# Media (photos, videos, narration) ships in the app's public/ folder and is
# served from the same origin (Vite locally, Cloudflare Pages in prod).
# Leave EMPTY unless you actually host media on a separate CDN.
VITE_MEDIA_BASE=

# Supabase — config, purchases, waypoint data
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Analytics (PostHog EU cloud)
# VITE_POSTHOG_KEY=phc_your_project_key

# Commerce — Lemon Squeezy hosted checkout (test mode until store is live)
# When unset, /landing tier CTAs open /purchase with step-by-step placeholders.
# Full wiring guide: docs/LEMON_SQUEEZY_TRANSACTIONS.md
# VITE_LEMON_CHECKOUT_URL=https://chronowalk.lemonsqueezy.com/checkout/buy/...
#
# Server-only (Supabase Edge Function secrets — never VITE_):
#   LEMON_SQUEEZY_WEBHOOK_SECRET=...
#   SITE_URL=https://chronowalk.com

# Optional Mapbox style for v2 warm map (M14)
# VITE_MAPBOX_STYLE_URL=mapbox://styles/your-account/style-id

# Local dev: teleport GPS to Rome for testing (or use ?geo_debug=true / ?debugGeo=true on any deploy)
VITE_DEBUG_GEO=true

# Field-test journey dev panel in preview/production (?devPanel=true also works)
# VITE_DEV_PANEL=true

# NOTE: VITE_V2_APP and VITE_FIGMA_REDESIGN are retired. Production always boots
# the v2 ChronoWalk redesign (see src/main.jsx); these variables are no longer read.

# Staging only — never on production chronowalk.com
# Enables /access?token=dev and "Complete staging purchase" on /purchase
# VITE_ALLOW_DEV_ACCESS=true

# Creator studio — AI prompt generator (?assetStudio=true&waypoint=colosseum)
# VITE_ASSET_STUDIO=true

# Optional — legacy CDN prefix (v1 assets)
# VITE_CDN_BASE_URL=https://cdn.example.com
