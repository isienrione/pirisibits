# Required — Mapbox public token (also set in Netlify Environment variables)
VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# Native iOS Simulator QA — Features → Location → Custom Location
# Rome near Colosseum: latitude 41.8902, longitude 12.4922
# (Permission grant ≠ GPS fix; without a simulated location the app must still enter the tour.)

# Native iOS (Capacitor) — public Mapbox token for Maps SDK / OfflineManager.
# Set as Xcode User-Defined Build Setting MAPBOX_ACCESS_TOKEN (Info.plist MBXAccessToken).
# Do NOT commit real tokens. Secret download tokens belong in local ~/.netrc only.
# MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here
# Optional native style override (defaults to mapbox://styles/mapbox/standard):
# CW_MAPBOX_STYLE_URI=mapbox://styles/mapbox/standard

# v2 media CDN (Cloudflare R2 custom domain)
# Media (photos, videos, narration) ships in the app's public/ folder and is
# served from the same origin (Vite locally, Cloudflare Pages in prod).
# Leave EMPTY unless you actually host media on a separate CDN.
VITE_MEDIA_BASE=

# Supabase — config, purchases, waypoint data
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Analytics (PostHog EU cloud)
# VITE_POSTHOG_KEY=phc_your_project_key

# Google Ads conversions (gtag) — Consent Mode v2 in index.html + src/lib/googleAds.js
# From Google Ads → Goals → Conversions → [conversion] → Tag setup / Use Google tag:
#   VITE_GOOGLE_ADS_ID = AW-XXXXXXXXX          (Conversion ID, shared by all tags)
#   VITE_GOOGLE_ADS_PURCHASE_LABEL = ………       (Purchase / primary conversion label)
#   VITE_GOOGLE_ADS_CHECKOUT_OPENED_LABEL = …… (checkout_opened secondary label)
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
# VITE_GOOGLE_ADS_PURCHASE_LABEL=
# VITE_GOOGLE_ADS_CHECKOUT_OPENED_LABEL=
# Commerce — Paddle Billing (one-time Rome packs)
# Full wiring guide: docs/PADDLE_SETUP.md
# Sandbox: test_… token + sandbox pri_… ids + VITE_PADDLE_ENV=sandbox
# Live:    live_… token + live pri_… ids + VITE_PADDLE_ENV=production
# Do NOT flip Cloudflare production to live until website approval + verification pass.
VITE_PADDLE_CLIENT_TOKEN=test_your_client_token
VITE_PADDLE_ENV=sandbox
# VITE_PADDLE_PRICE_ROME_CENTRAL=pri_...
# VITE_PADDLE_PRICE_ROME_ESSENTIAL=pri_...
# VITE_PADDLE_PRICE_ROME_COMPLETE=pri_...
# VITE_PADDLE_PRICE_ROME_COUPLE=pri_...
# VITE_PADDLE_PRICE_ROME_FAMILY=pri_...
# Optional success-link origin (defaults to window.location.origin)
# VITE_SITE_URL=https://chronowalk.com
#
# Server-only (Supabase Edge Function secrets — never VITE_):
#   PADDLE_API_KEY=pdl_sdbx_apikey_...   # or pdl_live_apikey_... for live
#   PADDLE_NOTIFICATION_WEBHOOK_SECRET=pdl_ntfset_...
#   PADDLE_ENV=sandbox                  # or production for live
#   PADDLE_PRICE_ROME_CENTRAL=pri_...
#   PADDLE_PRICE_ROME_ESSENTIAL=pri_...
#   PADDLE_PRICE_ROME_COMPLETE=pri_...
#   PADDLE_PRICE_ROME_COUPLE=pri_...
#   PADDLE_PRICE_ROME_FAMILY=pri_...
#   POSTHOG_PROJECT_API_KEY=phc_...     # server capture for purchase_confirmed (EU)
#   POSTHOG_HOST=https://eu.i.posthog.com
#   CLAIM_ENCRYPTION_KEY=...            # 32-byte base64 for outbox claim ciphertext
#   FULFILLMENT_CRON_SECRET=...         # process-fulfillment-outbox Bearer / header auth
#   RESEND_API_KEY=re_...
#   RESEND_FROM=ChronoWalk <hello@example.com>
#   RESEND_WEBHOOK_SECRET=whsec_...     # Svix signing secret for resend-webhook
#   SITE_URL=https://chronowalk.com
#   See docs/FULFILLMENT_OUTBOX.md for cron schedule (no secret values).
#
# Legacy Lemon Squeezy (no longer used by openCheckout):
# VITE_LEMON_CHECKOUT_URL=

# Optional Mapbox style overrides (defaults: Standard night on MAP tab,
# Standard Satellite dusk on the Walking-to hero — see src/map/mapStyles.js)
# VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/standard
# VITE_MAPBOX_WALKING_STYLE_URL=mapbox://styles/mapbox/standard-satellite

# Local dev: teleport GPS to Rome for testing (or use ?geo_debug=true / ?debugGeo=true on any deploy)
VITE_DEBUG_GEO=true

# Dev-only: override GPS with a fixed Colosseum-approach position so walking
# directions can be QA'd outside Rome. Also: ?simulate=rome (or rome-track).
# No-op in production builds.
# VITE_SIMULATE_LOCATION=rome

# Local StoreKit testing only (Capacitor iOS + ChronoWalkLocal.storekit).
# Put this in an untracked .env.local — never commit production builds with it set.
# Enables rome-central / rome-essential / rome-complete via isStoreKitMappingEnabled;
# Couple/Family stay deferred. Without this flag, Apple mappings remain disabled.
# VITE_STOREKIT_MODE=local

# Field-test journey dev panel in preview/production (?devPanel=true also works)
# VITE_DEV_PANEL=true

# Hidden diagnostics panel (?debug=1 or 5 rapid logo taps). Ships by default.
# Set true to tree-shake DebugPanel out of the production bundle entirely.
# VITE_STRIP_DEBUG_PANEL=true

# NOTE: VITE_V2_APP and VITE_FIGMA_REDESIGN are retired. Production always boots
# the v2 ChronoWalk redesign (see src/main.jsx); these variables are no longer read.

# Staging only — accept dev/local at /access without a purchase (set on chronowalk2, not production)
# VITE_ALLOW_DEV_ACCESS=true

# Creator studio — AI prompt generator (?assetStudio=true&waypoint=colosseum)
# VITE_ASSET_STUDIO=true

# Optional — legacy CDN prefix (v1 assets)
# VITE_CDN_BASE_URL=https://cdn.example.com
