# Dependencies & build output (regenerated; never commit)
node_modules
dist
dist-ssr

# Local env / secrets
.env
.env.*
!.env.example
*.local
# Paddle MCP keys / live migration secrets — keep templates only in git
.cursor/mcp.json
.cursor/paddle-live-migration.json

# Private incident / recovery SQL and local customer exports (never commit).
# Do not use these patterns for normal supabase/*.sql schema migrations.
*.local.sql
*.private.sql
.secrets/
**/customer-export*.csv
**/customers-export*.csv
**/paddle-customers-export*.csv
**/purchases-export*.csv
scripts/incident/

# Local working/source folders — raw assets, docs, and exports.
# These are NOT part of the deployed Vite app (build root is chronowalk/)
# and include large binaries (e.g. Chronowalk2/waypoints.zip, raw AUDIO/PHOTOGRAPHY).
# Final deliverables used by the app live in chronowalk/public.
/CHRONOWALK 3/
/Chronowalk2/

# Loose working docs dropped at project root
/*.make
/*.rtf

# OS cruft
.DS_Store

# Capacitor local IDE / sync noise (ios/ project is committed)
.capacitor

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
