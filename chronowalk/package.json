{
  "name": "chronowalk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:pwa-assets": "node scripts/generate-pwa-assets.mjs",
    "build": "npm run generate:pwa-assets && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run check:design && npm run check:assets && vitest run",
    "check:design": "node scripts/check-design.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "fetch:rome-landing-basemap": "node scripts/fetch-rome-landing-basemap.mjs",
    "process-pantheon": "bash scripts/process-pantheon-assets.sh",
    "verify-pantheon": "bash scripts/verify-pantheon-assets.sh",
    "process-waypoint": "bash scripts/process-waypoint-assets.sh",
    "verify-waypoint": "bash scripts/verify-waypoint-assets.sh",
    "verify-all-waypoints": "bash scripts/verify-all-waypoint-assets.sh",
    "install:modern-photos": "node scripts/install-modern-photos.mjs",
    "install:now-files": "node scripts/install-now-files.mjs",
    "process-piazza-navona": "bash scripts/process-waypoint-assets.sh piazza-navona",
    "verify-piazza-navona": "bash scripts/verify-waypoint-assets.sh piazza-navona",
    "process-expansion-waypoints": "bash scripts/process-expansion-waypoints.sh",
    "fix-expansion-folders": "bash scripts/fix-expansion-folders.sh",
    "diagnose-expansion-waypoints": "bash scripts/diagnose-expansion-waypoints.sh",
    "place-expansion-mp4": "bash scripts/place-expansion-mp4.sh",
    "git-add-expansion-media": "bash scripts/git-add-expansion-media.sh",
    "cleanup-expansion-folders": "bash scripts/cleanup-expansion-folders.sh",
    "normalize-audio": "bash scripts/normalize-audio.sh",
    "generate:rome-manifest": "node scripts/generate-rome-manifest.mjs",
    "measure:durations": "node scripts/measure-rome-durations.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:content:local": "node scripts/check-content.mjs --skip-remote",
    "check:content:strict": "node scripts/check-content.mjs --require-full-durations",
    "check:content:local:strict": "node scripts/check-content.mjs --skip-remote --require-full-durations",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.511.0",
    "mapbox-gl": "^3.25.0",
    "posthog-js": "^1.396.5",
    "react": "^19.2.6",
    "react-compare-slider": "^4.0.0",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.12",
