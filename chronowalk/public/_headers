# The service worker and app shell must never be held in the HTTP cache,
# otherwise browsers keep running an old service worker and never pick up
# new deploys. Content-hashed assets under /assets/ stay long-cached.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate
/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/404.html
  Cache-Control: no-cache, no-store, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
/favicon-*.png
  Cache-Control: public, max-age=3600, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate
/pwa/icon-*.png
  Cache-Control: public, max-age=3600, must-revalidate
/pwa/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate
/walking-ui-revision.json
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
/assets/*
  Cache-Control: public, max-age=31536000, immutable
