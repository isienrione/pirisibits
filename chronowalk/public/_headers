# The service worker and app shell must never be held in the HTTP cache,
# otherwise browsers keep running an old service worker and never pick up
# new deploys. Content-hashed assets under /assets/ stay long-cached.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/workbox-*.js
  Cache-Control: no-cache, no-store, must-revalidate
/registerSW.js
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
/favicon-*.png
  Cache-Control: public, max-age=3600, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate
/pwa/icon-*.png
  Cache-Control: public, max-age=3600, must-revalidate
/pwa/apple-touch-icon.png
  Cache-Control: public, max-age=3600, must-revalidate
/walking-ui-revision.json
  Cache-Control: no-cache, no-store, must-revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
/landing
  Cache-Control: no-cache, no-store, must-revalidate
/reset-shell
  Cache-Control: no-cache, no-store, must-revalidate
/reset-shell.html
  Cache-Control: no-cache, no-store, must-revalidate
/rome/reset-shell
  Cache-Control: no-cache, no-store, must-revalidate
/rome/reset-shell.html
  Cache-Control: no-cache, no-store, must-revalidate
/rome/open
  Cache-Control: no-cache, no-store, must-revalidate
/rome/open.html
  Cache-Control: no-cache, no-store, must-revalidate
# Hashed assets are content-addressed, but avoid year-long immutable caching:
# a deploy race can briefly serve a miss as HTML, and immutable would pin that
# poison on the custom domain. Keep this short enough that a bad HIT self-heals
# within an hour; new deploys also change the content hash so cold URLs miss.
/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
# SEO discovery files must never be served as the SPA shell (text/html).
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600, must-revalidate
