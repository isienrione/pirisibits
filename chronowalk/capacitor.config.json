{
  "appId": "com.chronowalk.app",
  "appName": "ChronoWalk",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "path": "native-review/ios",
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scheme": "ChronoWalk",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#0b0b0d",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b0b0d"
    }
  }
}
